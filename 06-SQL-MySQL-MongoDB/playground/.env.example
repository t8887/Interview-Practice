# Copy to .env before `make up`:  cp .env.example .env
#
# These are throwaway local credentials for a container that listens on
# localhost only. Do not reuse them anywhere real.

MYSQL_ROOT_PASSWORD=sqlplay
MYSQL_DATABASE=sqlplay
MYSQL_USER=sqlplay
MYSQL_PASSWORD=sqlplay

# 3307, not 3306, so this cannot collide with a local MySQL install.
MYSQL_PORT=3307

# Used by the TypeScript exercises in node/ (mysql2 pool).
MYSQL_HOST=127.0.0.1
